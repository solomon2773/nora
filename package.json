{
  "name": "nora-ci-tooling",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "contributor:setup": "node scripts/contributor.mjs setup",
    "contributor:check": "node scripts/contributor.mjs check",
    "scaffold:integration": "node scripts/scaffold-integration-provider.mjs",
    "scaffold:backend": "node scripts/scaffold-backend-adapter.mjs",
    "test:scaffolds": "node --test scripts/extension-scaffolds.test.mjs",
    "test:repository-metadata": "node --test scripts/repository-metadata.test.mjs",
    "validate:extensions": "node scripts/validate-extension-scaffolds.mjs",
    "ci:format:check": "prettier --check",
    "ci:format:write": "prettier --write",
    "ci:license-check": "node .github/workflows/scripts/license-check.mjs",
    "ci:lint": "eslint --ext .js,.jsx,.ts,.tsx,.cjs,.mjs --max-warnings=0",
    "ci:secret-scan": "node .github/workflows/scripts/scan-sensitive-config.mjs && node .github/workflows/scripts/scan-secrets.mjs && node --test .github/workflows/scripts/scan-secrets.test.mjs",
    "ci:validate-infra": "node .github/workflows/scripts/validate-infra.mjs && node --test scripts/infra-security.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "license-checker": "^25.0.1",
    "prettier": "^3.9.6",
    "yaml": "^2.9.0"
  }
}
