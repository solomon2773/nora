    "agent-management",
    "agent-orchestration",
    "openclaw",
    "hermes",
    "ops",
    "devops",
    "llmops",
    "docker",
    "kubernetes",
    "self-hosted"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3"
  }
}
